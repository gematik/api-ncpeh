@startuml webapp-runtime-states-eped-b
title Zustandsmodell WebApp für ePeD-B (zur Laufzeit)
hide empty description

skinparam defaultFontName "Liberation Sans, Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam arrowFontSize 11
skinparam roundCorner 8
skinparam nodesep 35
skinparam ranksep 40

skinparam state {
  BackgroundColor #FEFCBF
  BorderColor #7b7b7b
  StartColor #2D3748
  EndColor #2D3748
}

state WebAppReady #F7FAFC {
  state " " as inWebAppReady <<entryPoint>>
  state " " as outWebAppReady <<exitPoint>>
  inWebAppReady -> inAuth : start [ok]

  state Authenticating #FFFFFF {
    state " " as inAuth <<entryPoint>>
    state " " as outAuth <<exitPoint>>
    
    inAuth -down-> IdentityCheck : bootstrap-cookie-existing [ok]\n/ start-session-upgrade
    
    state IdentityCheck #FEFCBF {
      IdentityCheck : Output: ""IdentityAssertion""
      IdentityCheck : Output: ""AuthorizationTask.ncpehprx_access_token""
      IdentityCheck : Output: ""AuthorizationTask.euwp_id_token""
      IdentityCheck : \nPrüfung durch Auth-Service und ggf. Authenticator
    }

    state Authenticated #FEFCBF {
      Authenticated : Input: ""IdentityAssertion""
      Authenticated : Input: ""AuthorizationTask.ncpehprx_access_token""
    }

    IdentityCheck -down-> Authenticated : auth [token-and-ida-received]\n/ cache-token-and-ida
    Authenticated -down-> outAuth : [access-token-and-ida-known]
  }

  
  
  state EpedBActivity #FFFFFF {
    state " " as inEpedB <<entryPoint>>
    state " " as outEpedB <<exitPoint>>
    state " " as outEpedBLogout <<exitPoint>>
    state " " as outEpedBAborted <<exitPoint>>

    inEpedB -down-> HomeCountrySelection : start-of-workflow [ok]\n/ show-country-selection
    
    state HomeCountrySelection #FEFCBF {
      HomeCountrySelection : Output: ""PINDocument""
      HomeCountrySelection : Output: ""HPINDocument""
      HomeCountrySelection : Output: ""PINAcknowledgement""
      HomeCountrySelection : \nLand des EU-Bürgers auswählen und Datenschutz bestätigen
    }
    
    state PatientIdentification #F7FAFC {
      state " " as inPatientIdentification <<entryPoint>>
      state " " as outPatientIdentification <<exitPoint>> 
      state " " as outPatientIdentificationFail <<exitPoint>>
      
      state ISMInputAccept #FEFCBF {
        ISMInputAccept : Input: ""ISMInternationalHtmlList.ISMInternationalHtml""
        ISMInputAccept : Output: LE-DE Eingaben
      }

      inPatientIdentification -down-> ISMInputAccept : \nload [ok]\n/ show-country-specific-ism-form
      
      state ISMInputValid #FEFCBF {
        ISMInputValid : Output: ""PatientIdentificationQuery""
      }

      state ISMInputInvalid #FED7D7
      state PatientNotFound #FED7D7

      ISMInputAccept -down-> ISMInputValid : le-de-inputs [inputs-valid]\n/ prepare-query
      ISMInputAccept -right-> ISMInputInvalid : le-de-inputs [inputs-invalid]
      ISMInputInvalid -left-> ISMInputAccept : correct [inputs-invalid]\n/ show-warning
      ISMInputValid -down-> ISMDataCheck : search [inputs-valid]\n/ send-query
      
      state ISMDataCheck #FEFCBF {
        ISMDataCheck : Output: ""PatientIdentificationData""
        ISMDataCheck : \nIdentität des EU-Bürgers überprüfen
      }

      ISMDataCheck -right-> PatientNotFound : error [patient-not-found]\n/ show-warning
      PatientNotFound -left-> ISMInputAccept : le-de-new-inputs\n[no-patientidentifier-present]\n/ reset-previous-inputs
      ISMDataCheck -down-> outPatientIdentification : success [patient-found-and-identity-confirmed]
      PatientNotFound -down-> outPatientIdentificationFail : error [identity-not-confirmed]\n/ abort
    }

    HomeCountrySelection -down-> inPatientIdentification : ui-click [privacy-confirmed]\n/ initialize-search

    state PatientRelationshipConfirmed #C6F6D5 {
      PatientRelationshipConfirmed : Output: ""TRCAssertion""
    }

    outPatientIdentification -down-> PatientRelationshipConfirmed : success [patient-found-and-identity-confirmed]\n/ create-trc-assertion

    state PrescriptionListing #F7FAFC {
      state " " as inPrescriptionListing <<entryPoint>>
      state " " as outPrescriptionListing <<exitPoint>>
      state " " as outPrescriptionListingFail <<exitPoint>>
      state PrescriptionNotFound #FED7D7
      
      PrescriptionListing : Output: ""PrescriptionList""

      state PrescriptionSelection #FEFCBF {
        PrescriptionSelection : Output: ""SelectedPrescriptionRetrievalList""
        PrescriptionSelection : \nEinlösbare Rezepte auswählen
      }

      state PrescriptionRetrieved #FEFCBF {
        PrescriptionRetrieved : Output: ""PrescriptionRetrievedList""
        PrescriptionRetrieved : Output: ""DispensationList""
        PrescriptionRetrieved : \nempfangene(s) Rezept(e) für Abgabe vorbereitet
      }

      inPrescriptionListing -down-> PrescriptionSelection : \ntrc [ok]\n/ load-available-prescriptions
      inPrescriptionListing -right-> PrescriptionNotFound : error [no-prescriptions-found]
      PrescriptionNotFound -down-> outPrescriptionListingFail : error [no-prescriptions-found]

      PrescriptionSelection -down-> PrescriptionRetrieved : selection [prescriptions-selected]\n/ retrieve-prescriptions
      PrescriptionRetrieved -down-> outPrescriptionListing : success [prescriptions-retrieved-and-marked]
    }

    PatientRelationshipConfirmed -down-> inPrescriptionListing : trc [ok]
    
    state Dispensation #FEFCBF {
      Dispensation : Input: ""euwp_id_token""
      Dispensation : Output: ""DispensationInformation""
      Dispensation : (Output: ""SubstitutionInformation"")
      Dispensation : \nVerkaufsdaten komplettieren
    }
    
    outPrescriptionListing -down-> Dispensation : success [prescriptions-retrieved-and-marked]\n/ prepare-dispensation

    state ActivitySuccess #C6F6D5
    state ActivityAborted #FED7D7

    Dispensation -down-> ActivitySuccess : submit [data-complete]\n/ send-request

    outPatientIdentificationFail -down-> ActivityAborted : propagate-abort [ok]\n/ cleanup-inputs
    outPrescriptionListingFail -down-> ActivityAborted : propagate-abort [ok]\n/ cleanup-data
    
    ActivitySuccess -down-> outEpedBLogout : logout [ok]
    ActivitySuccess -down-> outEpedB : customer-served [success]
    ActivitySuccess -up-> inEpedB : next-customer [ok]\n/ cleanup-trc-assertion
    ActivityAborted -up-> inEpedB : next-customer [ok]

    ActivityAborted -down-> outEpedBAborted : abort [ok]\n/ cleanup-data
  }

  outAuth -down-> inEpedB : / start-workflow

  state Idle #EDF2F7
  EpedBActivity -[#C53030]-> Idle : long-le-de-inactivity\n[inactivity > ncpehprx_access_token-lifetime]\n/ hold-state
  Idle -[#C53030]-> EpedBActivity[H] : le-de-continues\n[ncpehprx_access_token-expired]\n/ use-refresh-token

  EpedBActivity -> ActivityAborted : ui-click [manual-abort]\n/ cleanup-data
  outEpedBAborted -down-> outWebAppReady : propagate-abort [ok]\n/ delete-tokens-and-cleanup-data
  outEpedB -down-> outWebAppReady : / delete-tokens-and-cleanup-data
}

outWebAppReady -down-> [*] : close-browser-tab [ok]

@enduml
